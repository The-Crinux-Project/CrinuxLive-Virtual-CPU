;   Fibonacci's sequence. There are no functions or conditionals yet, but it's a tradition so might as well.
;   main.bin is just this but compiled.
START:
    MOV r1, 0
    MOV r2, 1
    SYS PRINT r1
    SYS PRINT r2
    ADD r3, r1, r2
    SYS PRINT r3
    CPY r1, r2
    CPY r2, r3
    ADD r3, r1, r2
    SYS PRINT r3
    CPY r1, r2
    CPY r2, r3
    ADD r3, r1, r2
    SYS PRINT r3
    CPY r1, r2
    CPY r2, r3
    ADD r3, r1, r2
    SYS PRINT r3
    CPY r1, r2
    CPY r2, r3
    ADD r3, r1, r2
    SYS PRINT r3
    CPY r1, r2
    CPY r2, r3
    ADD r3, r1, r2
    SYS PRINT r3
    CPY r1, r2
    CPY r2, r3
    ADD r3, r1, r2
    SYS PRINT r3
    CPY r1, r2
    CPY r2, r3
    ADD r3, r1, r2
    SYS PRINT r3
END

